# Copy this file to `.env` and edit the values.

# ---------- LLM that writes the answers ----------
# Option A (default, free, runs on your laptop): Ollama
#   1. Install from https://ollama.com
#   2. Run:  ollama pull llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Option B: Groq (free tier, very fast). Get a key at https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key_here
# LLM_MODEL=llama-3.1-8b-instant

# Option C: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_key_here
# LLM_MODEL=gpt-4o-mini

# ---------- Retrieval ----------
DOCS_DIR=data/docs
INDEX_DIR=data/index
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=120
CHUNK_OVERLAP=30
TOP_K=4

# ---------- Hallucination checker ----------
# Bigger = more accurate but slower:
#   cross-encoder/nli-deberta-v3-xsmall                     (fastest)
#   MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli            (default, good balance)
#   MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli (most accurate)
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
DEVICE=auto
ENTAIL_THRESHOLD=0.5
CONTRA_THRESHOLD=0.5
WINDOWS_PER_CLAIM=6
WINDOW_SIZE=2
CHECK_NUMBERS=true
